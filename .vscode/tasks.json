{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Portfolio Localhost",
			"type": "shell",
			"command": "py.exe",
			"args": [
				"-m",
				"http.server",
				"8000",
				"--bind",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Open Live Portfolio in VS Code",
			"type": "shell",
			"command": "code",
			"args": [
				"--open-url",
				"vscode://vscode.simple-browser/show?url=https%3A%2F%2Fvoncompendio.pages.dev%2F"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "never",
				"panel": "shared",
				"close": true
			}
		}
	]
}